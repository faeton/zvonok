# Copy to .env ON THE DEPLOY HOST ONLY. Never commit a filled-in copy (BRIEF §6).
#
#   cp .env.example .env && chmod 600 .env
#
# ⚠ ALWAYS QUOTE VALUES. docker compose parses this file itself and tolerates
# bare values, but the shell scripts here `source` it — so an unquoted
# ZVONOK_OWNER_NAME=Ivan Sky makes bash try to run `Sky` and every script dies
# with "command not found". Quote everything and the two readers agree.

# LiveKit key/secret are self-generated — there is no LiveKit account.
# Generate with:  openssl rand -hex 16   /   openssl rand -base64 32
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# xAI API key (voice brain + extraction model).
XAI_API_KEY=""

# Filled in after ./lkctl.sh create-trunk
SIP_OUTBOUND_TRUNK_ID=""

# ---------------------------------------------------------------------------
# Identity the agent speaks on the call (BRIEF §5.3).
#
# ALL personal data lives here, in env on the deploy host — never in the repo.
# Every value is optional: anything unset simply drops out of the agent's
# prompt, and it will promise "the client will confirm" instead of inventing
# details.
# ---------------------------------------------------------------------------

# The _RU variants exist for PRONUNCIATION: the model reads Cyrillic correctly
# on a Russian call, Latin spelling it does not.
ZVONOK_OWNER_NAME=""              # e.g. "Ivan" — first name used for bookings
ZVONOK_OWNER_NAME_RU=""           # e.g. "Иван"
# Genitive: Russian says "ассистент Ивана" / "по поручению Ивана".
# Configured rather than derived — a mis-declined name in the opening sentence
# sounds wrong to a native ear.
ZVONOK_OWNER_NAME_RU_GEN=""       # e.g. "Ивана"
ZVONOK_OWNER_FULLNAME=""          # e.g. "Ivan Petrov" — only if a booking insists
ZVONOK_OWNER_FULLNAME_RU=""       # e.g. "Иван Петров"
ZVONOK_ASSISTANT_NAME="Klava"
ZVONOK_ASSISTANT_NAME_RU="Клава"

# Numbers the agent may hand out mid-call, when a booking or callback needs one.
# Booking phone should normally be the DID you call FROM (callable, SMS-able).
ZVONOK_BOOKING_PHONE=""           # e.g. "+44 7700 900123"
# Personal messenger number (WhatsApp etc.) — only given when specifically asked.
ZVONOK_MESSENGER_PHONE=""         # e.g. "+380 67 123 45 67"
# Optional dictation hint if the number is easy to mishear.
ZVONOK_MESSENGER_PHONE_NOTE=""    # e.g. "it has five zeros in a row — people mishear it"

# Linear gain on the agent's outgoing speech; 1.0 = model output as-is.
# 1.4 ≈ +3 dB — the default after callees reported the agent as quiet.
ZVONOK_OUTPUT_GAIN="1.4"

# ---------------------------------------------------------------------------
# Caller IDs (BRIEF §5.1 — a COST lever, ×20–34 measured swings by origin)
# ---------------------------------------------------------------------------

# Every DID verified on the SIP account, comma-separated E.164.
ZVONOK_OWNED_CALLER_IDS=""        # e.g. "+447700900123,+380671234567"
# Used when no per-country rule matches — your cheap origin.
ZVONOK_DEFAULT_CALLER_ID=""       # e.g. "+447700900123"
# Per-country overrides, "CC:+E164" comma-separated.
ZVONOK_CALLER_ID_BY_COUNTRY=""    # e.g. "UA:+380671234567"

# ---------------------------------------------------------------------------
# Phase 2 — call-api
# ---------------------------------------------------------------------------

# call-api binds to the host's TAILNET address, so it has no public surface at
# all and does not rely on the firewall staying correct. `tailscale ip -4`.
# Pick a port that is free on your host.
ZVONOK_BIND_HOST=""               # e.g. "100.x.y.z"
ZVONOK_API_PORT="18131"

POSTGRES_PASSWORD=""            # openssl rand -hex 24

# Per-client bearer tokens: identity:token, comma-separated. Per-agent identity
# is what makes per-agent caps and per-agent audit possible (BRIEF §5.5) —
# do NOT hand the same token to two clients.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ZVONOK_API_TOKENS="mac-claude:REPLACE_ME,openclaw:REPLACE_ME_TOO"

# The voice agent's token for reporting call outcomes back. Separate from client
# tokens: it can write results but cannot place calls.
ZVONOK_INTERNAL_TOKEN=""        # openssl rand -hex 32

# HMAC key for optional outbound webhooks. Leave empty to send them unsigned
# (only sensible for loopback consumers).
ZVONOK_WEBHOOK_SECRET=""

# Extraction model — xAI text model on the same key as the voice brain.
ZVONOK_EXTRACTOR_MODEL="grok-latest"

# Spend guardrails (BRIEF §6). Enforced per identity, before dispatch.
ZVONOK_MAX_CONCURRENT_CALLS="2"
ZVONOK_DAILY_CALLS="40"
ZVONOK_DAILY_MINUTES="60"
ZVONOK_DAILY_USD="10"
