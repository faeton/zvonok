# Copy to .env ON THE DEPLOY HOST ONLY. Never commit a filled-in copy (BRIEF §6).
#
#   cp .env.example .env && chmod 600 .env
#
# ⚠ ALWAYS QUOTE VALUES. docker compose parses this file itself and tolerates
# bare values, but the shell scripts here `source` it — so an unquoted
# ZVONOK_OWNER_NAME=Ivan Sky makes bash try to run `Sky` and every script dies
# with "command not found". Quote everything and the two readers agree.

# LiveKit key/secret are self-generated — there is no LiveKit account.
# Generate with:  openssl rand -hex 16   /   openssl rand -base64 32
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# xAI API key (voice brain + extraction model).
XAI_API_KEY=""

# Filled in after ./lkctl.sh create-trunk
SIP_OUTBOUND_TRUNK_ID=""

# ---------------------------------------------------------------------------
# Identity the agent speaks on the call (BRIEF §5.3).
#
# ALL personal data lives here, in env on the deploy host — never in the repo.
# Every value is optional: anything unset simply drops out of the agent's
# prompt, and it will promise "the client will confirm" instead of inventing
# details.
# ---------------------------------------------------------------------------

# The _RU variants exist for PRONUNCIATION: the model reads Cyrillic correctly
# on a Russian call, Latin spelling it does not.
ZVONOK_OWNER_NAME=""              # e.g. "Ivan" — first name used for bookings
ZVONOK_OWNER_NAME_RU=""           # e.g. "Иван"
# Genitive: Russian says "ассистент Ивана" / "по поручению Ивана".
# Configured rather than derived — a mis-declined name in the opening sentence
# sounds wrong to a native ear.
ZVONOK_OWNER_NAME_RU_GEN=""       # e.g. "Ивана"
ZVONOK_OWNER_FULLNAME=""          # e.g. "Ivan Petrov" — only if a booking insists
ZVONOK_OWNER_FULLNAME_RU=""       # e.g. "Иван Петров"
ZVONOK_ASSISTANT_NAME="Klava"
ZVONOK_ASSISTANT_NAME_RU="Клава"
# Polish has no native "v", so the name is spelled the Polish way for both
# pronunciation and transcription. Only used on `pl` calls, and not spoken at all
# at the `brief` disclosure level.
ZVONOK_ASSISTANT_NAME_PL="Klawa"

# Numbers the agent may hand out mid-call, when a booking or callback needs one.
# Booking phone should normally be the DID you call FROM (callable, SMS-able).
ZVONOK_BOOKING_PHONE=""           # e.g. "+44 7700 900123"
# Personal messenger number (WhatsApp etc.) — only given when specifically asked.
ZVONOK_MESSENGER_PHONE=""         # e.g. "+380 67 123 45 67"
# Optional dictation hint if the number is easy to mishear.
ZVONOK_MESSENGER_PHONE_NOTE=""    # e.g. "it has five zeros in a row — people mishear it"

# Linear gain on the agent's outgoing speech; 1.0 = model output as-is.
# 1.4 ≈ +3 dB — the default after callees reported the agent as quiet.
ZVONOK_OUTPUT_GAIN="1.4"

# ---------------------------------------------------------------------------
# Caller IDs (BRIEF §5.1 — a COST lever, ×20–34 measured swings by origin)
# ---------------------------------------------------------------------------

# Every DID verified on the SIP account, comma-separated E.164.
#
# ⚠ A NUMBER LISTED HERE WILL BE CALLED BACK. Whatever appears on a stranger's
# handset is what some fraction of them will ring later — a receptionist who was
# out, a shop that had to check the shelf, a wrong number returning a missed
# call. So only list a DID that DOES SOMETHING when it rings (BRIEF §5.6).
#
# Listing one that reaches dead air is worse than not owning it: the people who
# get silence are precisely the ones we just interrupted, and they associate it
# with the number we will keep dialling them from. That is answer-rate we cannot
# buy back. Keep an unanswered DID out of this list even when it is technically
# verified and cheaper to dial from.
ZVONOK_OWNED_CALLER_IDS=""        # e.g. "+447700900123,+380671234567"
# Used when no per-country rule matches — your cheap origin.
ZVONOK_DEFAULT_CALLER_ID=""       # e.g. "+447700900123"
# Per-country overrides, "CC:+E164" comma-separated.
ZVONOK_CALLER_ID_BY_COUNTRY=""    # e.g. "UA:+380671234567"

# ---------------------------------------------------------------------------
# Phase 2 — call-api
# ---------------------------------------------------------------------------

# call-api binds to the host's TAILNET address, so it has no public surface at
# all and does not rely on the firewall staying correct. `tailscale ip -4`.
# Pick a port that is free on your host.
ZVONOK_BIND_HOST=""               # e.g. "100.x.y.z"
ZVONOK_API_PORT="18131"

POSTGRES_PASSWORD=""            # openssl rand -hex 24

# Per-client bearer tokens: identity:token, comma-separated. Per-agent identity
# is what makes per-agent caps and per-agent audit possible (BRIEF §5.5) —
# do NOT hand the same token to two clients.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ZVONOK_API_TOKENS="mac-claude:REPLACE_ME,openclaw:REPLACE_ME_TOO"

# The voice agent's token for reporting call outcomes back. Separate from client
# tokens: it can write results but cannot place calls.
#
# PER TENANT (ZVONOK_INTERNAL_TOKEN_<TENANT>), and it does not inherit — an
# added tenant with no token of its own fails startup. This token is how the
# internal endpoints learn WHOSE call is being reported on, so a shared one lets
# either tenant's worker settle the other's calls: replace the transcript,
# settle the outcome, and trigger extraction against the other's xAI key. Room
# names embed the job id and the LiveKit credential is shared, so finding a
# target is not the hard part.
ZVONOK_INTERNAL_TOKEN=""        # openssl rand -hex 32

# HMAC key for optional outbound webhooks. Leave empty to send them unsigned
# (only sensible for loopback consumers).
ZVONOK_WEBHOOK_SECRET=""

# Extraction model — xAI text model on the same key as the voice brain.
ZVONOK_EXTRACTOR_MODEL="grok-latest"

# Spend guardrails (BRIEF §6). Enforced per identity, before dispatch.
# ZVONOK_MAX_CONCURRENT_CALLS is also the BOX ceiling — de1's CPU and upstream
# bandwidth do not care whose call it is.
ZVONOK_MAX_CONCURRENT_CALLS="2"
ZVONOK_DAILY_CALLS="40"
ZVONOK_DAILY_MINUTES="60"
ZVONOK_DAILY_USD="10"

# ---------------------------------------------------------------------------
# A SECOND TENANT — someone else's calls on your box
# ---------------------------------------------------------------------------
#
# Only for someone with their OWN Zadarma account and their OWN xAI key. If you
# were thinking of putting a friend on your trunk, don't: a DID is verified
# against one specific SIP account, so their calls would present YOUR number,
# bill YOUR balance, and send every callback to YOU — and one spam complaint
# suspends the account both of you depend on.
#
# ⚠ Have them use SIP CREDENTIAL auth (username/password) on their trunk, not
# IP auth. Yours is authorised by de1's static IP; if their account whitelists
# the same IP, two accounts claim the same source and which one Zadarma bills is
# not something to discover from an invoice.
#
# Everything below is a SUFFIX on an existing variable, and there are two kinds:
#
#   _<TENANT>    account settings — trunk, DIDs, xAI key, worker name.
#                Deliberately NOT inherited from the unsuffixed variable: a
#                forgotten one must fail loudly, never silently fall back to
#                YOUR key or YOUR numbers.
#   _<IDENTITY>  spend caps and audit. Several identities can share one tenant
#                (mac-claude and openclaw are both you); each gets its own
#                budget. These DO inherit — a forgotten cap is just the default.
#
# The compose service is `agent-tenant2`, so the tenant must be named `tenant2`.
# The identity name is yours to choose; it appears in the audit log.

# Uncomment to start their worker. deploy.sh runs a plain `docker compose up`,
# and compose reads this from .env.
#COMPOSE_PROFILES="tenant2"

# Their bearer token — append to ZVONOK_API_TOKENS above, e.g.
#   ZVONOK_API_TOKENS="mac-claude:...,openclaw:...,friend:THEIR_TOKEN"
# and map that identity onto their account:
#ZVONOK_TENANT_FRIEND="tenant2"

# Their account. No fallbacks: leave one empty and call-api refuses to start.
#XAI_API_KEY_TENANT2=""
#SIP_OUTBOUND_TRUNK_ID_TENANT2=""        # ./lkctl.sh create-trunk, with THEIR SIP credentials
#ZVONOK_AGENT_NAME_TENANT2="zvonok-caller-friend"   # must differ from ZVONOK_AGENT_NAME
#ZVONOK_AGENT_PORT_TENANT2="18132"       # must differ — host networking, real ports
#ZVONOK_OWNED_CALLER_IDS_TENANT2=""      # DIDs verified on THEIR Zadarma account
#ZVONOK_DEFAULT_CALLER_ID_TENANT2=""
#ZVONOK_CALLER_ID_BY_COUNTRY_TENANT2=""
#ZVONOK_INTERNAL_TOKEN_TENANT2=""        # openssl rand -hex 32 — NOT the same as yours
# Transcript directories to create per tenant. Each worker mounts only its own:
# the janitor recovers lost callbacks by reading these files, and that path
# settles a call and bills extraction without presenting any token, so a shared
# directory would let either worker claim the other's calls.
#ZVONOK_TRANSCRIPT_TENANTS="transcripts/tenant2"

# Who their agent says it is on the call (BRIEF §5.3). Same rules as yours.
#ZVONOK_OWNER_NAME_TENANT2=""
#ZVONOK_OWNER_NAME_RU_TENANT2=""
#ZVONOK_OWNER_NAME_RU_GEN_TENANT2=""
#ZVONOK_OWNER_FULLNAME_TENANT2=""
#ZVONOK_OWNER_FULLNAME_RU_TENANT2=""
#ZVONOK_ASSISTANT_NAME_TENANT2=""
#ZVONOK_ASSISTANT_NAME_RU_TENANT2=""
#ZVONOK_ASSISTANT_NAME_PL_TENANT2=""
#ZVONOK_BOOKING_PHONE_TENANT2=""
#ZVONOK_MESSENGER_PHONE_TENANT2=""
#ZVONOK_MESSENGER_PHONE_NOTE_TENANT2=""

# Their caps, by IDENTITY. Set the concurrency share on BOTH sides — left at the
# default, either of you can fill the box alone and starve the other. call-api
# warns at startup if you forget.
#ZVONOK_MAX_CONCURRENT_CALLS_FRIEND="1"
#ZVONOK_MAX_CONCURRENT_CALLS_MAC_CLAUDE="1"
#ZVONOK_DAILY_CALLS_FRIEND="20"
#ZVONOK_DAILY_MINUTES_FRIEND="30"
#ZVONOK_DAILY_USD_FRIEND="5"
#ZVONOK_MAX_DURATION_HARD_FRIEND="600"

# What stays shared, and cannot be split without a second LiveKit and a second
# Postgres: LIVEKIT_API_KEY (room admin — their worker could in principle join
# your rooms), the jobs database, and the transcript directory. API-level
# isolation is real — neither of you can read the other's
# calls through call-api — but their callees' voice data sits on your disk under
# your retention policy, which makes you a processor for it. Fine between people
# who know each other. Not a substitute for per-tenant infrastructure.
